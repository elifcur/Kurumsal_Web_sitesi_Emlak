# ---------------------------------------------------------------
# Emlak Sitesi - Üretim (cPanel) ortamı örnek ayarları
# Bu dosyayı sunucuda ".env" olarak kopyalayın ve değerleri doldurun.
# ---------------------------------------------------------------
APP_NAME="Firma Adı"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.alanadiniz.com

# Bu pakette teslim edilen sektör şablonu (değiştirmeyin)
APP_TEMPLATE=real-estate

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=error
LOG_DAILY_DAYS=14

# cPanel > MySQL Databases bölümünden oluşturduğunuz bilgiler
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cpaneluser_site
DB_USERNAME=cpaneluser_site
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
# Document root public_html ise: FILESYSTEM_UPLOADS_ROOT=/home/cpaneluser/public_html/uploads

# İletişim formu bildirimleri (cPanel > Email Accounts ile oluşturulan hesap)
MAIL_MAILER=smtp
MAIL_HOST=mail.alanadiniz.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=noreply@alanadiniz.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@alanadiniz.com
MAIL_FROM_NAME="${APP_NAME}"

# İlk kurulumda oluşturulacak süper yönetici (deploy.sh / db:seed)
ADMIN_NAME="Yönetici"
ADMIN_EMAIL=admin@alanadiniz.com
ADMIN_PASSWORD=

# Maksimum yükleme boyutu (KB). cPanel PHP ayarlarındaki upload_max_filesize ile uyumlu olmalı.
CMS_UPLOAD_MAX_KB=5120
