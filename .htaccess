# ------------------------------------------------------------------
# Fallback: document root uygulama kök dizinine işaret ediyorsa tüm
# istekleri public/ altına yönlendirir ve hassas dosyaları gizler.
# Önerilen kurulum yine de document root'u "public" yapmaktır.
# ------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^(\.env.*|composer\.(json|lock)|package(-lock)?\.json|artisan|phpunit\.xml|vite\.config\.js|deploy\.sh|\.gitignore)$">
    Require all denied
</FilesMatch>

RedirectMatch 403 ^/(app|bootstrap|config|database|resources|routes|storage|templates|tests|vendor|node_modules|docs|deploy)(/|$)
Options -Indexes
